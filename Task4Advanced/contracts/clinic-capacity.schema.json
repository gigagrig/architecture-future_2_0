{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preliminary ClinicCapacityPublished v1",
  "description": "MVP allowlist for administrative daily capacity, never clinical records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "source",
    "aggregate_id",
    "aggregate_version",
    "region_id",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "ClinicCapacityPublished"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "source": {
      "const": "care-delivery"
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^clinic-[a-z0-9-]+/[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "region_id": {
      "type": "string",
      "pattern": "^region-[a-z0-9-]+$"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clinic_id",
        "period_start",
        "period_end",
        "available_slots",
        "booked_slots"
      ],
      "properties": {
        "clinic_id": {
          "type": "string",
          "pattern": "^clinic-[a-z0-9-]+$"
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "available_slots": {
          "type": "integer",
          "minimum": 0
        },
        "booked_slots": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
