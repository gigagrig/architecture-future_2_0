flowchart TB
  web["Web-портал<br/>Container: React"]
  idp["IdP<br/>External system: OIDC"]
  catalog["Каталог продуктов<br/>Container: OpenMetadata"]
  marts[("Доменные витрины<br/>Container: ClickHouse")]
  meta[("Метаданные портала<br/>Container: PostgreSQL")]
  audit["Аудит<br/>Container: OTel + хранилище"]
  subgraph api["Container: API портала, Java / Spring Boot"]
    controller["HTTP Controller<br/>Component: REST<br/>Входные DTO и лимиты"]
    auth["Identity Adapter<br/>Component: OIDC/JWT<br/>Проверка подписи, срока и групп"]
    policy["Access Policy<br/>Component: Java<br/>Домен, регион, строки и столбцы"]
    products["Product Catalog Adapter<br/>Component: HTTPS client<br/>Версии и доступность продукта"]
    planner["Query Planner<br/>Component: Java<br/>Разрешённая семантическая модель"]
    jobs["Report Job Service<br/>Component: Java<br/>Очередь заданий в PostgreSQL"]
    worker["Report Worker<br/>Component: Java<br/>Повторная проверка прав и выполнение"]
    repo["Report Repository<br/>Component: SQL<br/>Определения и задания"]
    sink["Audit Writer<br/>Component: OTLP client<br/>Запрос, решение, результат"]
  end
  web -->|HTTPS; конструктор или отчёт| controller
  controller -->|JWT| auth
  auth -->|HTTPS; JWKS| idp
  controller -->|Контекст пользователя| policy
  policy -->|SQL; актуальные правила| meta
  controller -->|Проверенный запрос| planner
  planner -->|Схема продукта| products
  products -->|HTTPS| catalog
  planner -->|Проверка каждого набора полей| policy
  planner -->|Задание с версией продукта| jobs
  jobs -->|Записать задание| repo
  repo -->|SQL/TLS| meta
  worker -->|Получить и завершить задание| repo
  worker -->|Права на момент выполнения| policy
  worker -->|SQL/TLS; ограниченная роль| marts
  controller -->|Проверить владельца при выдаче| jobs
  jobs -->|Права на момент скачивания| policy
  controller -->|Действие и решение| sink
  worker -->|Статус и объём| sink
  sink -->|OTLP/TLS| audit
